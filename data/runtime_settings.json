  "alert_workflow": {
    "auto_merge_incidents": true,
    "case_note_templates": [
      {
        "body": "Contacted customer and verified transaction intent.",
        "id": "customer-callback",
        "title": "Customer callback"
      },
      {
        "body": "Reviewed merchant history, velocity, and linked alerts.",
        "id": "merchant-review",
        "title": "Merchant review"
      }
    ],
    "dedupe_window_minutes": 30,
    "escalation_policy": [
      {
        "auto_assign": "admin@paywatch.ai",
        "id": "policy-critical",
        "route_to": "fraud-war-room",
        "severity": "critical",
        "sla_minutes": 15
      },
      {
        "auto_assign": "analyst@paywatch.ai",
        "id": "policy-high",
        "route_to": "tier-2-analyst",
        "severity": "high",
        "sla_minutes": 45
      }
    ],
    "evidence_checklist": [
      "Owner assigned",
      "Cause tag selected",
      "Evidence attached",
      "Resolution note"
    ],
    "playbooks": [
      {
        "alert_type": "TRANSFER",
        "steps": [
          "Validate actor",
          "Compare destination history",
          "Attach evidence",
          "Escalate if loss exposure exceeds policy"
        ],
        "title": "High-value transfer review"
      },
      {
        "alert_type": "CASH_OUT",
        "steps": [
          "Check repeat actor",
          "Review device velocity",
          "Confirm merchant/customer contact"
        ],
        "title": "Cash-out velocity review"
      }
    ],
    "similarity_threshold": 0.72,
    "sla_policy": {
      "critical": 15,
      "high": 30,
      "low": 120,
      "medium": 45
    },
    "suppression_rules": [
      {
        "condition": "risk=LOW and repeats>=3",
        "enabled": true,
        "id": "repeat-destination-low-risk",
        "name": "Suppress repeated low-risk destination chatter",
        "window_minutes": 20
      }
    ]
  },
  "api_keys": [
    {
      "id": "default-ingest",
